[Unit]
Description=ATOM local application service
After=network.target

[Service]
Type=simple
User=linaro
WorkingDirectory=/home/linaro/atom
ExecStart=/usr/bin/python3 /home/linaro/atom/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
UMask=0077
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/tmp/pulse-socket

[Install]
WantedBy=multi-user.target
