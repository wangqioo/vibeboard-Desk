{
  "manifest": {
    "id": "fluid-atlas",
    "name": "流体画布",
    "description": "移植Pavel WebGL Fluid Simulation，GPU实时流体与染料模拟",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "theme_ui": "controls"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#03050b;color:#fff;font:14px system-ui,sans-serif}canvas,#scene{display:block;width:100%;height:100%}.head{position:fixed;top:12px;left:14px;pointer-events:none;text-shadow:0 1px 5px #000}h1{font-size:20px;margin:0}p{font-size:11px;color:#b9c7d9;margin:5px 0}.controls{position:fixed;bottom:12px;left:12px;right:12px;display:flex;gap:6px}button{min-height:44px;flex:1;background:#111b30df;border:1px solid #45516b;color:#e9edfa;border-radius:7px;font:14px system-ui;padding:6px 8px}button.active{background:#eed4ac;color:#192137}.fps{position:fixed;right:14px;top:15px;font:11px monospace;color:#b9c7d9;pointer-events:none}button:focus-visible{outline:2px solid white}#failure{position:fixed;top:100px;left:20px;right:20px;background:#182034;padding:16px;display:none}</style></head><body><canvas></canvas><div class=\"head\"><h1>流体画布</h1><p>Pavel Dobryakov · 拖动注入彩色流体</p></div><div class=\"controls\"><button id=\"burst\">迸发</button><button id=\"pause\">暂停</button><button id=\"quality\">精细</button><button id=\"clear\">清空</button></div><span id=\"fps\" class=\"fps\">测量中</span><div id=\"failure\"></div><script>window.addEventListener(\"error\",function(e){var n=document.getElementById(\"failure\");n.style.display=\"block\";n.textContent=\"渲染失败：\"+e.message;});var frames=0,last=performance.now();function measure(t){frames++;if(t-last>1000){document.getElementById(\"fps\").textContent=Math.round(frames*1000/(t-last))+\" FPS\";frames=0;last=t}requestAnimationFrame(measure)}requestAnimationFrame(measure);</script><script src=\"script.js\"></script><script src=\"controls.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>流体画布</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 45c-17-24 23-40 26-21 3 14-26 20-25 8 0-8 13-17 20-8M22 49c8 8 26-4 25-15\" /></g></svg>"
  }
}