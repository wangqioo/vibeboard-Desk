{
  "manifest": {
    "id": "planetarium",
    "name": "天体观测台",
    "description": "移植Spacekit，高清行星纹理、光照、大气和土星环",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "theme_ui": "controls"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#03050b;color:#fff;font:14px system-ui,sans-serif}canvas,#scene{display:block;width:100%;height:100%}.head{position:fixed;top:12px;left:14px;pointer-events:none;text-shadow:0 1px 5px #000}h1{font-size:20px;margin:0}p{font-size:11px;color:#b9c7d9;margin:5px 0}.controls{position:fixed;bottom:12px;left:12px;right:12px;display:flex;gap:6px}button{min-height:44px;flex:1;background:#111b30df;border:1px solid #45516b;color:#e9edfa;border-radius:7px;font:14px system-ui;padding:6px 8px}button.active{background:#eed4ac;color:#192137}.fps{position:fixed;right:14px;top:15px;font:11px monospace;color:#b9c7d9;pointer-events:none}button:focus-visible{outline:2px solid white}#failure{position:fixed;top:100px;left:20px;right:20px;background:#182034;padding:16px;display:none}</style></head><body><div id=\"scene\"></div><div class=\"head\"><h1 id=\"title\">正在加载天体…</h1><p>Spacekit · 拖动环绕 · 滚轮缩放</p></div><div class=\"controls\"><button data-planet=\"earth\" class=\"active\">地球</button><button data-planet=\"jupiter\">木星</button><button data-planet=\"saturn\">土星</button><button id=\"spin\">暂停巡航</button></div><span id=\"fps\" class=\"fps\">测量中</span><div id=\"failure\"></div><script>window.addEventListener(\"error\",function(e){var n=document.getElementById(\"failure\");n.style.display=\"block\";n.textContent=\"渲染失败：\"+e.message;});var frames=0,last=performance.now();function measure(t){frames++;if(t-last>1000){document.getElementById(\"fps\").textContent=Math.round(frames*1000/(t-last))+\" FPS\";frames=0;last=t}requestAnimationFrame(measure)}requestAnimationFrame(measure);</script><script src=\"spacekit.js\"></script><script src=\"main.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>天体观测台</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"32\" cy=\"32\" r=\"15\" /><path d=\"M21 22c9 0 13 7 8 12s8 7 8 12M36 17l2 9 8 4M9 49l45-33\" /></g></svg>"
  }
}