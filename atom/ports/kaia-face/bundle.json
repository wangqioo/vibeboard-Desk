{
  "manifest": {
    "id": "kaia-face",
    "name": "表情星球",
    "description": "Kaia 的丰富表情 · 点击心动",
    "entry": "index.html",
    "icon": "icon.svg",
    "theme_ui": "controls",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\"><title>表情星球</title><link rel=\"stylesheet\" href=\"common.css\"><style>#stage{display:flex;justify-content:center;align-items:center}#face{width:340px;height:340px}#face canvas{width:340px;height:340px}</style></head><body><main id=\"stage\"><div id=\"face\"></div></main><button id=\"menu\" aria-label=\"打开控制\">···</button><section id=\"panel\" class=\"atomtools\" hidden><header>表情星球<button id=\"close\" aria-label=\"关闭控制\">×</button></header><div class=\"row\"><select id=\"mood\" aria-label=\"表情\"><option>正在准备表情</option></select></div><div class=\"row\"><button id=\"wink\">眨眼</button><button id=\"auto\">自动表情：开</button></div><p id=\"status\">准备动画…</p><p>控制会自动隐藏 · 空格键返回桌面</p></section><div id=\"hint\">移动鼠标，眼睛跟随 · 点击送它一颗心</div><div id=\"error\"></div><script src=\"common.js\"></script><script src=\"fabric.js\"></script><script src=\"engine.js\"></script><script src=\"main.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.4\"><circle cx=\"32\" cy=\"32\" r=\"23\" /><path d=\"M17 28q5-7 10 0m10 0q5-7 10 0M23 40q9 8 18 0\" /></svg>"
  }
}