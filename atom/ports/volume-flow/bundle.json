{
  "manifest": {
    "id": "volume-flow",
    "name": "体积流场",
    "description": "体积流场 · 实时交互",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "theme_ui": "controls"
  },
  "files": {
    "index.html": "<!doctype html><html><head><script>var NativeImage=Image;window.Image=function(w,h){var i=new NativeImage(w,h);i.crossOrigin=\"anonymous\";return i};Image.prototype=NativeImage.prototype;</script><meta charset=\"utf-8\"><script crossorigin=\"anonymous\" src=\"webgl2-compat.js\"></script><style>html,body{margin:0;height:100%;overflow:hidden;font:14px sans-serif}canvas{display:block}.atomtools{position:fixed;bottom:10px;left:12px;right:12px;display:flex;gap:6px;z-index:100}.atomtools button{height:40px;flex:1;border:1px solid #ffffff66;background:#14202de8;color:white;border-radius:8px;font:13px sans-serif}.atomtitle{position:fixed;left:14px;top:12px;z-index:100;font:13px sans-serif;color:white;pointer-events:none;text-shadow:0 1px 4px #000}body{background:#e6e6e6}#render{position:absolute;inset:0}.atomtitle{color:#24334b;text-shadow:none}</style></head><body><canvas id=\"render\"></canvas><div class=\"atomtitle\">体积流场 · 拖动旋转 · 滚轮缩放</div><div class=\"atomtools\"><button id=\"quality\">4千粒子</button><button id=\"color\">换色</button><button id=\"curl\">变换流场</button><button id=\"speed\">暂停</button></div><script crossorigin=\"anonymous\" src=\"shared.js\"></script><script crossorigin=\"anonymous\" src=\"flow.js\"></script><script crossorigin=\"anonymous\" src=\"main.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>体积流场</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 38c9-25 12 25 21 0s10-3 18-11M13 26c10-21 10 21 22 0\" /><circle cx=\"48\" cy=\"40\" r=\"4\" /><circle cx=\"22\" cy=\"49\" r=\"3\" /><circle cx=\"44\" cy=\"16\" r=\"2\" /></g></svg>"
  }
}