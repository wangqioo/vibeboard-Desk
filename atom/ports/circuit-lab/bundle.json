{
  "manifest": {
    "id": "circuit-lab",
    "name": "电路实验室",
    "description": "CircuitJS1 · RLC、整流与555真实电路仿真",
    "entry": "index.html",
    "layout": "fullscreen",
    "theme_ui": "controls",
    "icon": "icon.svg"
  },
  "files": {
    "index.html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"gwt:property\" content=\"locale=en_UK\"><title>电路实验室</title><link rel=\"stylesheet\" href=\"font/fontello.css\"><style>html,body{height:100%;margin:0!important;overflow:hidden;font:13px sans-serif;background:var(--bg);color:var(--ink)}canvas{position:relative;top:28px}.head{position:fixed;top:6px;left:12px;right:12px;display:flex;justify-content:space-between;z-index:100}.atomtools{position:fixed;bottom:8px;left:10px;right:10px;display:flex;gap:6px;z-index:100}.atomtools button,.atomtools select{height:40px;font:13px sans-serif;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;flex:1}.atomtools select{flex:1.8;min-width:0}.gwt-DialogBox{max-width:440px!important;max-height:310px!important;overflow:auto;background:var(--card)!important;color:var(--ink)!important}.gwt-DialogBox input{max-width:100px}.gwt-MenuItem{font-size:12px}.gwt-Frame{border:0}.offScreen{position:absolute;right:101%;overflow:hidden}#status{font-size:11px;color:var(--muted)}#error{position:fixed;inset:40px 20px 70px;background:var(--card);padding:20px;z-index:101;display:none}</style><script>window.atomSearch='?hideMenu=true&hideSidebar=true&hideInfoBox=true&running=true&editable=true&startCircuit=lrc.txt&lang=en';window.oncircuitjsloaded=function(sim){window.atomCircuitLoaded(sim)};</script><script src=\"lz-string.min.js\"></script><script src=\"main.js\"></script></head><body><div class=\"head\"><span>电路实验室</span><span id=\"status\">正在初始化求解器…</span></div><div class=\"atomtools\"><select id=\"preset\" aria-label=\"实验电路\"><option value=\"lrc\">RLC振荡</option><option value=\"rectifier\">半波整流</option><option value=\"timer\">555振荡器</option></select><button id=\"pause\">暂停</button><button id=\"change\">参数×1</button><button id=\"reset\">重置</button></div><div id=\"error\"></div><script src=\"circuitjs1/circuitjs1.nocache.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.4\"><path d=\"M8 24h10l3-6 6 12 6-12 6 12 3-6h14M8 24v24h18m12 0h18V24M26 39v18m12-18v18\" /></svg>"
  }
}