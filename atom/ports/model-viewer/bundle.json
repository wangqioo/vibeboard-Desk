{
  "manifest": {
    "id": "model-viewer",
    "name": "模型检视台",
    "description": "离线STL/OBJ模型检查 · Three.js",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "theme_ui": "controls"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#15202b;color:#e3ecf3;font:13px sans-serif}canvas{display:block;width:100%;height:100%;touch-action:none}.top{position:fixed;top:12px;left:14px;pointer-events:none}.top b{font-size:17px}.top p{font-size:11px;color:#97adbf;margin:6px 0}.bottom{position:fixed;bottom:12px;left:12px;right:12px;display:flex;gap:6px}button,select{border:1px solid #566878;background:#223448e8;color:#e3ecf3;border-radius:7px;min-height:40px;padding:0 10px;font:13px sans-serif;min-width:0}.bottom button{flex:1}.info{position:fixed;left:14px;bottom:64px;font:11px monospace;color:#b1c7d8;pointer-events:none}.error{position:fixed;top:70px;left:14px;right:14px;background:#803828;color:white;padding:12px;display:none}</style></head><body><div class=\"top\"><b>模型检视台</b><p id=\"name\">拖动旋转 · 滚轮缩放 · 本地文件不上传</p></div><div id=\"info\" class=\"info\"></div><div id=\"error\" class=\"error\"></div><div class=\"bottom\"><button id=\"open\">打开模型</button><select id=\"sample\"><option value=\"sculpture\">雕塑</option><option value=\"gear\">齿轮</option><option value=\"bracket\">结构件</option></select><button id=\"wire\">线框</button><button id=\"rotate\">巡航</button><button id=\"fit\">归位</button></div><input id=\"file\" type=\"file\" accept=\".stl,.obj\" hidden><script crossorigin=\"anonymous\" src=\"three.min.js\"></script><script crossorigin=\"anonymous\" src=\"OrbitControls.js\"></script><script crossorigin=\"anonymous\" src=\"STLLoader.js\"></script><script crossorigin=\"anonymous\" src=\"OBJLoader.js\"></script><script crossorigin=\"anonymous\" src=\"main.js\"></script></body></html>\n",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>模型检视台</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m32 12 20 12v24L32 59 12 48V24ZM12 24l20 12 20-12M32 36v23M32 12v24M12 48l20-12 20 12\" /></g></svg>"
  }
}