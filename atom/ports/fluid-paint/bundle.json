{
  "manifest": {
    "id": "fluid-paint",
    "name": "颜料画室",
    "description": "WebGL实时交互 · 颜料画室",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "theme_ui": "controls"
  },
  "files": {
    "index.html": "<!DOCTYPE html>\n<html>\n    <head><script src=\"webgl2-compat.js\"></script>\n        <meta charset=\"utf-8\">\n        <title>Fluid Paint</title>\n\n        <meta name=\"description\" content=\"Fluid paint simulation\">\n        <link rel=\"stylesheet\" href=\"paint.css\">\n    </head>\n\n    <body>\n        <script type=\"text/template\" id=\"main\">\n            <div id=\"ui\">\n                <div id=\"clear-button\" class=\"button\">Clear</div><div id=\"save-button\" class=\"button\">Save</div>\n\n                <div class=\"control-label\">Quality</div>\n                <div class=\"buttons\" id=\"qualities\"></div>\n                <div style=\"clear:both\"></div>\n\n                <div class=\"control-label\">Color Mode</div>\n                <div class=\"buttons\" id=\"models\"></div>\n                <div style=\"clear:both\"></div>\n\n                <div class=\"control-label\">Paint Fluidity</div>\n                <div id=\"fluidity-slider\" class=\"slider\"></div>\n\n                <div class=\"control-label\">Bristle Count</div>\n                <div id=\"bristles-slider\" class=\"slider\"></div>\n\n                <div class=\"control-label\">Brush Size</div>\n                <div id=\"size-slider\" class=\"slider\"></div>\n\n                <div class=\"control-label\">Paint Color</div>\n\n                <div id=\"undo-button\" class=\"button\">Undo</div><div id=\"redo-button\" class=\"button\">Redo</div>\n            </div>\n\n\n            <div id=\"instructions\">\n                <span>Click and hold</span> to paint <br/>\n                <span>Scroll</span> to change brush size<br/>\n                <span>Space + drag</span> to pan<br/>\n                <span>Drag edges</span> to resize canvas\n            </div>\n\n            <div id=\"footer\">\n                <a href=\"http://david.li\">david.li</a> | <a href=\"http://github.com/dli/paint\">Source code</a>\n            </div>\n        </script>\n\n        <script type=\"text/template\" id=\"no-support\">\n            <div id=\"no-support-container\">\n                <div id=\"error\"></div>\n                <div id=\"backlink\"><a href=\"http://david.li\">Back to david.li</a></div>\n            </div>\n        </script>\n\n        <div id=\"placeholder\"></div>\n\n\n        <script crossorigin=\"anonymous\" src=\"wrappedgl.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"utilities.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"rectangle.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"brush.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"simulator.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"colorpicker.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"slider.js\"></script>\n        <script crossorigin=\"anonymous\" src=\"buttons.js\"></script>\n        <!--<script crossorigin=\"anonymous\" src=\"brushviewer.js\"></script>-->\n        <script crossorigin=\"anonymous\" src=\"paint.js\"></script>\n\n        <script>\n            'use strict';\n\n            var canvas = document.createElement('canvas');\n            var wgl = WrappedGL.create(canvas);\n\n            if (wgl !== null && wgl.hasFloatTextureSupport()) { //required features are supported\n                document.body.appendChild(canvas);\n                document.getElementById('placeholder').outerHTML = document.getElementById('main').innerHTML;\n                var painter = new Paint(canvas, wgl);\n            } else { //required features unsupported\n                document.getElementById('placeholder').outerHTML = document.getElementById('no-support').innerHTML;\n\n                if (wgl === null) {\n                    document.getElementById('error').innerHTML = 'Unfortunately, your browser does not support WebGL.';\n                } else {\n                    document.getElementById('error').innerHTML = 'Unfortunately, your browser does not support WebGL floating point textures.';\n                }\n            }\n        </script>\n\n    <style>html,body{margin:0;height:100%;overflow:hidden;font-family:sans-serif}#ui,#instructions,#footer{display:none!important}canvas{position:absolute;left:0;top:0}.tools{position:fixed;bottom:10px;left:12px;right:12px;display:flex;gap:6px;z-index:10}button{height:40px;border:1px solid #ffffff80;border-radius:8px;padding:0 10px;background:#23313be8;color:white;font:13px sans-serif}.color{width:36px;flex-shrink:0}.title{position:fixed;top:10px;left:14px;z-index:10;font:13px sans-serif;color:#25313b;pointer-events:none}</style><div class=\"title\">颜料画室 · 拖动绘画 · 滚轮调笔刷</div><div class=\"tools\"><button class=\"color\" style=\"background:#ee3355\" onclick=\"painter.brushColorHSVA=[.97,.85,1,.8]\"></button><button class=\"color\" style=\"background:#267be9\" onclick=\"painter.brushColorHSVA=[.6,.85,1,.8]\"></button><button class=\"color\" style=\"background:#ffca28\" onclick=\"painter.brushColorHSVA=[.13,.9,1,.8]\"></button><button onclick=\"painter.brushScale=painter.brushScale===22?40:22;this.textContent=painter.brushScale===22?'细笔':'粗笔'\">细笔</button><button onclick=\"painter.undo()\">撤销</button><button onclick=\"painter.redo()\">重做</button><button onclick=\"painter.clear()\">清空</button></div></body>\n</html>\n",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>颜料画室</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m25 39 20-24 6 6-22 23ZM25 39c-12-3-7 14-15 14 13 2 20-3 19-9\" /><path d=\"m39 22 7 7\" /></g></svg>"
  }
}