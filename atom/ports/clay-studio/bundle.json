{
  "manifest": {
    "id": "clay-studio",
    "name": "黏土工坊",
    "description": "SculptGL真实雕刻 · 低面数离线",
    "entry": "index.html",
    "layout": "fullscreen",
    "theme_ui": "controls",
    "icon": "icon.svg"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><link rel=\"stylesheet\" crossorigin=\"anonymous\" href=\"css/yagui.css\"><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;font:14px system-ui,sans-serif;background:var(--bg,#f3f0e8);color:var(--ink,#242622)}canvas{display:block;touch-action:none}.controls{position:absolute;bottom:8px;left:8px;right:8px;display:flex;gap:6px;z-index:10}button,select{height:48px;min-width:0;padding:0 10px;background:var(--card,#f3f0e8);color:var(--ink,#242622);border:1px solid var(--line,#d5d3c8);border-radius:6px;font:14px system-ui,sans-serif}.controls>*{flex:1}.top{position:absolute;top:8px;left:12px;right:12px;z-index:10;pointer-events:none}.top strong{font-size:18px}.top p{margin:4px 0;font-size:12px}.status{position:absolute;bottom:64px;left:12px;right:12px;font-size:12px;pointer-events:none}.error{position:absolute;top:80px;left:12px;right:12px;background:var(--card,#f3f0e8);color:var(--action,#b53c28);padding:12px;display:none;z-index:11}#viewport{position:absolute!important;left:0!important;right:0!important;top:56px!important;bottom:78px!important;width:100%!important;height:calc(100% - 134px)!important}#canvas{width:100%;height:100%}.top *,.status{color:var(--ink,#242622)}</style><script>var NI=Image;window.Image=function(w,h){var i=new NI(w,h);i.crossOrigin='anonymous';return i};Image.prototype=NI.prototype;</script></head><body><div class=\"top\"><strong>黏土工坊</strong><p>拖动雕刻 · 右键转动 · 滚轮缩放</p></div><div id=\"viewport\"><canvas id=\"canvas\"></canvas></div><div id=\"status\" class=\"status\">准备黏土</div><div id=\"error\" class=\"error\"></div><div class=\"controls\"><button id=\"tool\">堆土</button><button id=\"negative\">凸起</button><button id=\"undo\">撤销</button><button id=\"reset\">重置</button></div><input id=\"fileopen\" type=\"file\" multiple hidden><input id=\"backgroundopen\" type=\"file\" hidden><input id=\"alphaopen\" type=\"file\" hidden><input id=\"textureopen\" type=\"file\" hidden><input id=\"matcapopen\" type=\"file\" hidden><script crossorigin=\"anonymous\" src=\"sculptgl.js\"></script><script crossorigin=\"anonymous\" src=\"main.js\"></script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.4\"><g transform=\"scale(1.3333333)\"><path d=\"M12 35c-6-9-2-20 7-23 7-3 16 1 18 9 3 9-3 16-11 17-6 1-10-1-14-3Z\" /><path d=\"m19 18 9 4-3 10m-11-6 8 1\" /></g></svg>"
  }
}