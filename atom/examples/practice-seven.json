{
  "manifest": {
    "id": "practice-seven",
    "name": "七次练习",
    "description": "累计一轮七次练习，适用于阅读、拉伸、练琴等进度记录",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg"
  },
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>七次练习</title>\n<style>\n:root{--atom-paper:#ffe49b;--atom-ink:#302c22;--atom-accent:#e27328;--atom-action:#9b431d;--atom-muted:#685738;--atom-secondary-text:#685738;--atom-line:#c6ad6b;--atom-card:#ffedbd;--bg:#ffe49b;--ink:#302c22;--accent:#e27328;--action:#9b431d;--muted:#685738;--line:#c6ad6b;--card:#ffedbd;--paper:#ffe49b;--text:#302c22;--secondary-text:#685738;--secondaryText:#685738;--atom-secondaryText:#685738;--atom-bg:#ffe49b;--icon-bg:#ffedbd;--icon-ink:#302c22;--icon-border:transparent;--icon-radius:16px;--icon-stroke:2.9;--icon-border-style:none}\n\n*{box-sizing:border-box;}\nhtml,body{height:100%;}\nbody{\n  height:100vh;\n  margin:0;\n  background:var(--atom-bg,var(--bg,#ffe49b));\n  color:var(--atom-ink,var(--text,#302c22));\n  font-family:system-ui,-apple-system,\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;\n  font-size:16px;\n  line-height:1.4;\n  overflow:hidden;\n}\n#app{\n  height:100%;\n  max-width:480px;\n  margin:0 auto;\n  padding:14px 18px 16px;\n  display:flex;\n  flex-direction:column;\n  gap:10px;\n  overflow:hidden;\n}\nheader{flex:0 0 auto;}\nheader h1{\n  margin:0;\n  font-size:17px;\n  font-weight:600;\n  letter-spacing:.02em;\n  color:var(--atom-ink,var(--text,#302c22));\n}\nheader p{\n  margin:2px 0 0;\n  font-size:13px;\n  color:var(--atom-secondary-text,var(--secondary-text,#685738));\n}\n.main{\n  flex:1 1 auto;\n  min-height:0;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  gap:10px;\n}\n#count{\n  font-size:64px;\n  font-weight:700;\n  line-height:1;\n  color:var(--atom-action,var(--action,#9b431d));\n  font-variant-numeric:tabular-nums;\n}\n.marks{\n  display:flex;\n  gap:8px;\n  align-items:flex-end;\n  height:34px;\n}\n.mark{\n  width:16px;\n  height:16px;\n  border-radius:4px;\n  border:2px solid var(--atom-line,var(--line,#c6ad6b));\n  background:transparent;\n  transition:background-color .18s ease,border-color .18s ease,transform .18s ease;\n}\n.mark.done{\n  background:var(--atom-accent,var(--accent,#e27328));\n  border-color:var(--atom-accent,var(--accent,#e27328));\n  transform:translateY(-4px);\n}\n.status{\n  font-size:15px;\n  min-height:22px;\n  color:var(--atom-secondary-text,var(--secondary-text,#685738));\n  text-align:center;\n}\n.status.done{\n  color:var(--atom-action,var(--action,#9b431d));\n  font-weight:600;\n}\n.controls{\n  flex:0 0 auto;\n  display:flex;\n  gap:10px;\n  align-items:stretch;\n}\nbutton{\n  font:inherit;\n  font-size:16px;\n  border-radius:12px;\n  border:2px solid transparent;\n  cursor:pointer;\n  min-height:48px;\n  padding:0 16px;\n  transition:background-color .15s ease,color .15s ease,border-color .15s ease;\n}\nbutton:focus-visible{\n  outline:3px solid var(--atom-action,var(--action,#9b431d));\n  outline-offset:2px;\n}\n.btn-primary{\n  flex:2 1 auto;\n  background:var(--atom-accent,var(--accent,#e27328));\n  color:#fff;\n  font-weight:600;\n}\n.btn-primary:hover:not(:disabled){background:var(--atom-action,var(--action,#9b431d));}\n.btn-secondary{\n  flex:1 1 auto;\n  background:var(--atom-card,var(--card,#ffedbd));\n  color:var(--atom-ink,var(--text,#302c22));\n  border-color:var(--atom-line,var(--line,#c6ad6b));\n}\n.btn-secondary:hover:not(:disabled){border-color:var(--atom-action,var(--action,#9b431d));}\nbutton:disabled{\n  opacity:.42;\n  cursor:not-allowed;\n}\n.message{\n  flex:0 0 auto;\n  font-size:13px;\n  min-height:18px;\n  color:var(--atom-action,var(--action,#9b431d));\n  text-align:center;\n}\n.confirm{\n  flex:1 1 auto;\n  min-height:0;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  gap:12px;\n  text-align:center;\n}\n.confirm p{\n  margin:0;\n  font-size:16px;\n}\n.confirm .controls{width:100%;}\n.sr-only{\n  position:absolute;\n  width:1px;height:1px;\n  padding:0;margin:-1px;\n  overflow:hidden;\n  clip:rect(0,0,0,0);\n  white-space:nowrap;\n  border:0;\n}\n@media (prefers-reduced-motion:reduce){\n  *{transition:none !important;}\n}\n</style>\n<style id=\"atom-theme\">:root{--atom-paper:#ffe49b;--atom-ink:#302c22;--atom-accent:#e27328;--atom-action:#9b431d;--atom-muted:#685738;--atom-secondary-text:#685738;--atom-line:#c6ad6b;--atom-card:#ffedbd;--bg:#ffe49b;--ink:#302c22;--accent:#e27328;--action:#9b431d;--muted:#685738;--line:#c6ad6b;--card:#ffedbd;--paper:#ffe49b;--text:#302c22;--secondary-text:#685738;--secondaryText:#685738;--atom-secondaryText:#685738;--atom-bg:#ffe49b;--icon-bg:#ffedbd;--icon-ink:#302c22;--icon-border:transparent;--icon-radius:16px;--icon-stroke:2.9;--icon-border-style:none}</style></head>\n<body>\n<div id=\"app\">\n  <header>\n    <h1>七次练习</h1>\n    <p>一轮共七次，完成即为一步。</p>\n  </header>\n\n  <section class=\"main\" id=\"main\" aria-live=\"polite\">\n    <div id=\"count\">0</div>\n    <div class=\"marks\" id=\"marks\" role=\"img\" aria-label=\"进度刻度\"></div>\n    <div class=\"status\" id=\"status\">开始第一</div>\n  </section>\n\n  <div class=\"message\" id=\"message\" role=\"alert\"></div>\n\n  <div class=\"controls\" id=\"controls\">\n    <button id=\"undo\" class=\"btn-secondary\" type=\"button\" disabled>撤销</button>\n    <button id=\"add\" class=\"btn-primary\" type=\"button\">完成一次</button>\n    <button id=\"reset\" class=\"btn-secondary\" type=\"button\">重新开始</button>\n  </div>\n</div>\n\n<script>\n(function(){\n  'use strict';\n\n  var TOTAL = 7;\n  var n = 0;\n  var busy = false;\n  var confirming = false;\n\n  var countEl = document.getElementById('count');\n  var marksEl = document.getElementById('marks');\n  var statusEl = document.getElementById('status');\n  var messageEl = document.getElementById('message');\n  var addBtn = document.getElementById('add');\n  var undoBtn = document.getElementById('undo');\n  var resetBtn = document.getElementById('reset');\n  var mainEl = document.getElementById('main');\n  var controlsEl = document.getElementById('controls');\n\n  AtomApp.deferReady();\n\n  function buildMarks(){\n    marksEl.innerHTML = '';\n    for(var i=0;i<TOTAL;i++){\n      var d = document.createElement('div');\n      d.className = 'mark';\n      marksEl.appendChild(d);\n    }\n  }\n\n  function render(){\n    countEl.textContent = String(n);\n    var marks = marksEl.children;\n    for(var i=0;i<TOTAL;i++){\n      if(i<n){ marks[i].classList.add('done'); }\n      else { marks[i].classList.remove('done'); }\n    }\n    if(n >= TOTAL){\n      statusEl.textContent = '这一轮完成了';\n      statusEl.classList.add('done');\n    } else {\n      statusEl.classList.remove('done');\n      statusEl.textContent = '还需 ' + (TOTAL - n) + ' 次';\n    }\n    addBtn.disabled = busy || n >= TOTAL;\n    undoBtn.disabled = busy || n <= 0;\n    resetBtn.disabled = busy || n === 0;\n  }\n\n  function setBusy(b){\n    busy = b;\n    render();\n  }\n\n  function showMessage(text, isError){\n    messageEl.textContent = text || '';\n    messageEl.style.color = isError\n      ? 'var(--atom-action,var(--action,#9b431d))'\n      : 'var(--atom-secondary-text,var(--secondary-text,#685738))';\n  }\n\n  function nextState(){\n    if(confirming) return;\n    if(busy || n >= TOTAL) return;\n    showMessage('', false);\n    attemptSave(n + 1);\n  }\n\n  function undoState(){\n    if(confirming) return;\n    if(busy || n <= 0) return;\n    showMessage('', false);\n    attemptSave(n - 1);\n  }\n\n  function attemptSave(next){\n    setBusy(true);\n    var p;\n    try {\n      p = AtomApp.save({ n: next });\n    } catch(e){\n      setBusy(false);\n      showMessage('保存失败，请重试。', true);\n      return;\n    }\n    Promise.resolve(p).then(function(){\n      n = next;\n      setBusy(false);\n      showMessage('已保存', false);\n    }).catch(function(){\n      setBusy(false);\n      showMessage('保存失败，请重试。', true);\n    });\n  }\n\n  /* ---- reset with in-app confirmation ---- */\n  var confirmWrap = null;\n\n  function openConfirm(){\n    if(confirming || busy || n === 0) return;\n    confirming = true;\n    showMessage('', false);\n\n    mainEl.style.display = 'none';\n    controlsEl.style.display = 'none';\n\n    confirmWrap = document.createElement('div');\n    confirmWrap.className = 'confirm';\n\n    var p = document.createElement('p');\n    p.textContent = '确定重新开始吗？当前进度将清零。';\n\n    var ctrls = document.createElement('div');\n    ctrls.className = 'controls';\n\n    var cancelBtn = document.createElement('button');\n    cancelBtn.type = 'button';\n    cancelBtn.className = 'btn-secondary';\n    cancelBtn.textContent = '取消';\n    cancelBtn.addEventListener('click', closeConfirm);\n\n    var okBtn = document.createElement('button');\n    okBtn.type = 'button';\n    okBtn.className = 'btn-primary';\n    okBtn.textContent = '确认清零';\n    okBtn.addEventListener('click', doReset);\n\n    ctrls.appendChild(cancelBtn);\n    ctrls.appendChild(okBtn);\n    confirmWrap.appendChild(p);\n    confirmWrap.appendChild(ctrls);\n\n    var app = document.getElementById('app');\n    app.insertBefore(confirmWrap, messageEl);\n    okBtn.focus();\n  }\n\n  function closeConfirm(){\n    if(!confirming) return;\n    confirming = false;\n    if(confirmWrap && confirmWrap.parentNode){\n      confirmWrap.parentNode.removeChild(confirmWrap);\n    }\n    confirmWrap = null;\n    mainEl.style.display = '';\n    controlsEl.style.display = '';\n    render();\n  }\n\n  function doReset(){\n    if(!confirming) return;\n    // remove confirm UI first\n    if(confirmWrap && confirmWrap.parentNode){\n      confirmWrap.parentNode.removeChild(confirmWrap);\n    }\n    confirmWrap = null;\n    confirming = false;\n    mainEl.style.display = '';\n    controlsEl.style.display = '';\n\n    showMessage('', false);\n    setBusy(true);\n    var p;\n    try {\n      p = AtomApp.save({ n: 0 });\n    } catch(e){\n      setBusy(false);\n      showMessage('保存失败，请重试。', true);\n      return;\n    }\n    Promise.resolve(p).then(function(){\n      n = 0;\n      setBusy(false);\n      showMessage('已重新开始', false);\n      addBtn.focus();\n    }).catch(function(){\n      setBusy(false);\n      showMessage('保存失败，进度未变。', true);\n    });\n  }\n\n  addBtn.addEventListener('click', nextState);\n  undoBtn.addEventListener('click', undoState);\n  resetBtn.addEventListener('click', openConfirm);\n\n  document.addEventListener('keydown', function(e){\n    if(e.key === 'Escape' && confirming){\n      closeConfirm();\n    }\n  });\n\n  buildMarks();\n\n  var loadP;\n  try {\n    loadP = AtomApp.load({ n: 0 });\n  } catch(e){\n    loadP = Promise.resolve({ n: 0 });\n  }\n\n  Promise.resolve(loadP).then(function(state){\n    var val = state && typeof state.n === 'number' ? state.n : 0;\n    if(!isFinite(val) || val < 0) val = 0;\n    if(val > TOTAL) val = TOTAL;\n    n = Math.floor(val);\n    render();\n    AtomApp.ready();\n  }).catch(function(){\n    n = 0;\n    render();\n    showMessage('读取失败，已从 0 开始。', true);\n    AtomApp.ready();\n  });\n\n  if(typeof AtomApp.onSuspend === 'function'){\n    AtomApp.onSuspend(function(){\n      if(confirmWrap && confirmWrap.parentNode){\n        confirmWrap.parentNode.removeChild(confirmWrap);\n      }\n      confirmWrap = null;\n      confirming = false;\n      mainEl.style.display = '';\n      controlsEl.style.display = '';\n      busy = false;\n    });\n  }\n})();\n</script>\n</body>\n</html>\n",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 64 64\" stroke-width=\"2.4\">\n  <title>七次练习</title>\n  <line x1=\"12\" x2=\"12\" y1=\"14\" y2=\"30\" />\n  <line x1=\"18\" x2=\"18\" y1=\"14\" y2=\"30\" />\n  <line x1=\"24\" x2=\"24\" y1=\"14\" y2=\"30\" />\n  <line x1=\"30\" x2=\"30\" y1=\"14\" y2=\"30\" />\n  <line x1=\"36\" x2=\"36\" y1=\"14\" y2=\"30\" />\n  <line x1=\"42\" x2=\"42\" y1=\"14\" y2=\"30\" />\n  <line x1=\"48\" x2=\"48\" y1=\"14\" y2=\"30\" />\n  <path d=\"M20 44 L28 52 L46 34\" />\n  <line x1=\"11\" x2=\"49\" y1=\"34\" y2=\"34\" />\n</svg>"
  }
}