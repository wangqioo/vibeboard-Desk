{
  "manifest": {
    "id": "template-tool",
    "name": "饮水计数器",
    "description": "记录本次打开期间的杯数",
    "entry": "index.html",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>饮水计数器</title><style>/* ATOM shared application primitives. No network fonts or decorative effects. */\n:root{--atom-paper:#f3f0e8;--atom-ink:#242622;--atom-accent:#df5038;--atom-muted:#787a70;--atom-action:#b53c28;--atom-secondary-text:#62665d;--atom-line:#d5d3c8;--atom-space:8px;--atom-radius:6px;--atom-font:system-ui,-apple-system,BlinkMacSystemFont,\"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif;--atom-mono:ui-monospace,SFMono-Regular,Consolas,monospace}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\n.atom-app{box-sizing:border-box;background:var(--atom-paper);color:var(--atom-ink);font:400 16px/1.5 var(--atom-font);padding:16px;margin:0;height:100vh;min-height:0;overflow:hidden;display:flex;flex-direction:column}\n.atom-scroll,[data-atom-scroll]{min-height:0;overflow:auto;overscroll-behavior:contain;flex:1;touch-action:pan-y}\n.atom-app *{box-sizing:border-box}\n.atom-app h1{font-size:24px;line-height:1.25;margin:0 0 16px;font-weight:600}\n.atom-app p{margin:0 0 16px}\n.atom-button{appearance:none;font:600 16px/1.25 var(--atom-font);min-height:48px;padding:8px 16px;border:1px solid var(--atom-ink);border-radius:var(--atom-radius);background:transparent;color:var(--atom-ink);cursor:pointer;touch-action:manipulation}\n.atom-button:focus-visible{outline:2px solid var(--atom-accent);outline-offset:3px}\n.atom-button:active{background:var(--atom-line)}\n.atom-button:disabled{opacity:.45;cursor:default}\n.atom-button-primary{background:var(--atom-action);color:var(--atom-paper);border-color:var(--atom-action)}\n.atom-button-primary:active{background:var(--atom-ink);border-color:var(--atom-ink)}\n.atom-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0}\n.atom-panel{border:1px solid var(--atom-line);border-radius:0;padding:16px;margin:16px 0}\n.atom-label{color:var(--atom-secondary-text);font:400 12px/1.5 var(--atom-font)}\n.atom-number{font-family:var(--atom-mono);font-variant-numeric:tabular-nums;line-height:1.1}\n.atom-message{font-size:14px;line-height:1.5;border-left:2px solid var(--atom-accent);padding:8px 0 8px 8px;margin:16px 0}\n@media(prefers-reduced-motion:reduce){.atom-app *{animation:none!important;transition:none!important}}\n.atom-app{padding:16px}.atom-app h1{margin-bottom:8px}.atom-app p{margin-bottom:8px}.atom-row{flex-shrink:0}.atom-message{font-size:12px;margin:8px 0}.atom-panel{padding:8px;margin:8px 0}.atom-panel .atom-row{margin:4px 0}.atom-panel .atom-button{width:100%;text-align:left;font-size:14px}.atom-app>h1,.atom-app>p,.atom-app>div{flex-shrink:0}.atom-app h1{margin-bottom:4px}.atom-app p{margin-bottom:4px}.atom-row{margin:4px 0}.atom-message{margin:4px 0}</style></head><body class=\"atom-app\"><h1>饮水计数器</h1><p class=\"atom-label\">本次打开 · 杯</p><div id=\"count\" class=\"atom-number\" style=\"font-size:56px;margin:8px 0\">0</div><div id=\"buttons\"></div><p class=\"atom-message\">只保留本次计数；重新打开会归零。</p><script>(function(global){'use strict';\nfunction escape(value){return String(value==null?'':value).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction button(text,options){options=options||{};return '<button type=\"button\" class=\"atom-button'+(options.primary?' atom-button-primary':'')+'\"'+(options.id?' id=\"'+escape(options.id)+'\"':'')+(options.disabled?' disabled':'')+'>'+escape(text)+'</button>'}\nfunction label(text){return '<span class=\"atom-label\">'+escape(text)+'</span>'}\n// row accepts trusted component HTML, not arbitrary user text. Escape text first.\nfunction row(items){return '<div class=\"atom-row\">'+items.join('')+'</div>'}\nglobal.AtomUI={escape:escape,button:button,label:label,row:row};\n})(window);\n\nvar n=0;document.getElementById('buttons').innerHTML=AtomUI.row([AtomUI.button('喝了一杯',{id:'add',primary:true}),AtomUI.button('撤销',{id:'undo',disabled:true})]);function draw(){document.getElementById('count').textContent=n;document.getElementById('undo').disabled=n===0}document.getElementById('add').onclick=function(){n++;draw()};document.getElementById('undo').onclick=function(){n=Math.max(0,n-1);draw()};</script></body></html>"
  }
}
